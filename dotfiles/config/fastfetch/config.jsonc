
{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"padding": {
"top": 0
}
},
"display": {
"separator": " 󰑃  "
},
"modules": [
    "title",
    "separator",
    "break",
    {
    "type": "os",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "kernel",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "wm",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "cpu",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "gpu",
    "key": "󰺵",
    "format": "{2}",
    "keyColor": "blue"
    },
    {
    "type": "memory",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "packages",
    "key": "",
    "keyColor": "blue"
    },
    {
    "type": "uptime",
    "key": "󰥔",
    "keyColor": "blue"
    },
    {
    "type": "command",
    "key": "",
    "keyColor": "blue",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
    },
    {
    "type": "command",
    "key": "",
    "keyColor": "blue",
    "text": "birth_install=$(stat -c %W /); echo $(date -d @$birth_install '+%d %b %Y')"
    },

]

}
