LAYOUTS = [
    ("Playfield.json", PLAYFIELD),
    ("SongSelect.json", SONGSELECT),
    ("MainHUDComponents.json", MAINHUD),
]


def find_osu_dir():
    for entry in sorted(os.listdir("/mnt/")):
        candidate = os.path.join("/mnt/", entry, "osu!stuff", "osu!")
        if os.path.isdir(candidate):
            return candidate
    print("Error: no 'osu!' directory found under /mnt/", file=sys.stderr)
    sys.exit(1)


def update_skin_ini(skin_path, name):
    path = os.path.join(skin_path, "skin.ini")
    if not os.path.isfile(path):
        return None

    with open(path) as f:
        lines = f.readlines()

    new_lines = []
    creator = "Unknown"
    name_found = False
    for line in lines:
        stripped = line.lstrip()
        lower = stripped.lower()
        if lower.startswith("name:") or lower.startswith("name="):
            new_lines.append(f"Name: {name}\n")
            name_found = True
        elif lower.startswith("author:") or lower.startswith("author="):
            creator = stripped.split(":", 1)[-1].strip() if ":" in stripped else stripped.split("=", 1)[-1].strip()
            new_lines.append(line)
        elif lower.startswith("creator:") or lower.startswith("creator="):
            if creator == "Unknown":
                creator = stripped.split(":", 1)[-1].strip() if ":" in stripped else stripped.split("=", 1)[-1].strip()
            new_lines.append(line)
        else:
            new_lines.append(line)

    if not name_found:
        for i, line in enumerate(new_lines):
            if line.strip().lower() == "[general]":
                for j in range(i + 1, len(new_lines)):
                    if new_lines[j].startswith("["):
                        new_lines.insert(j, f"Name: {name}\n")
                        name_found = True
                        break
                if not name_found:
                    new_lines.append(f"Name: {name}\n")
                break

    with open(path, "w") as f:
        f.writelines(new_lines)

    return creator


def update_skininfo(skin_path, name, creator):
    info = {
        "Name": name,
        "Creator": creator,
        "InstantiationInfo": "osu.Game.Skinning.LegacySkin, osu.Game"
    }
    with open(os.path.join(skin_path, "skininfo.json"), "w") as f:
        json.dump(info, f, indent=2)
        f.write("\n")


def ensure_layout_files(skin_path):
    for filename, content in LAYOUTS:
        path = os.path.join(skin_path, filename)
        if not os.path.isfile(path):
            with open(path, "w") as f:
                json.dump(content, f, indent=2)
                f.write("\n")


def main():
    osu_dir = find_osu_dir()
    skins_dir = os.path.join(osu_dir, "Skins")

    if not os.path.isdir(skins_dir):
        print(f"Error: {skins_dir} is not a directory", file=sys.stderr)
        sys.exit(1)

    entries = sorted(os.listdir(skins_dir))
    total = 0
    for entry in entries:
        skin_path = os.path.join(skins_dir, entry)
        if not os.path.isdir(skin_path):
            continue
        total += 1

        name = entry
        creator = update_skin_ini(skin_path, name) or "Unknown"
        update_skininfo(skin_path, name, creator)
        ensure_layout_files(skin_path)

        print(f"  {entry}: updated")

    print(f"\nDone — {total} skins processed")


if __name__ == "__main__":
    main()
